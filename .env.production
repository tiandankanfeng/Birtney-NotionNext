# 本站生产环境的公开展示配置；独立维护，便于持续同步上游代码。
# NEXT_PUBLIC_THEME_SWITCH 优先于 Notion 的同名开关；其余配置遵循上游优先级。
NEXT_PUBLIC_THEME=fukasawa
# 本站夜空人物头像独立保存，避免上游更新默认 favicon 时替换。
NEXT_PUBLIC_FAVICON=/komoribe-icon.png
NEXT_PUBLIC_THEME_SWITCH=false
NEXT_PUBLIC_CUSTOM_RIGHT_CLICK_CONTEXT_MENU_THEME_SWITCH=false
NEXT_PUBLIC_MUSIC_PLAYER=false
NEXT_PUBLIC_WIDGET_PET=false
NEXT_PUBLIC_WIDGET_PET_SWITCH_THEME=false
NEXT_PUBLIC_DEBUG=false
NEXT_PUBLIC_MOUSE_FOLLOW=false
NEXT_PUBLIC_SAKURA=false
NEXT_PUBLIC_STARRY_SKY=false
# 保留复制链接，关闭评论、公开计数和侧栏标签云；Notion 配置中心保持同值。
NEXT_PUBLIC_COMMENT_ENV_ID=false
NEXT_PUBLIC_POST_SHARE_SERVICES=link
NEXT_PUBLIC_CAN_COPY=true
NEXT_PUBLIC_ANALYTICS_BUSUANZI_ENABLE=false
NEXT_PUBLIC_FUKASAWA_SIDEBAR_TAGS=false
# 显式保留本站原字体资源，避免上游改用系统字体后展示变化。
NEXT_PUBLIC_FONT_URL='["https://fonts.googleapis.com/css?family=Bitter:300,400,700&display=swap","https://fonts.googleapis.com/css2?family=Noto+Sans+SC:wght@300;400;500;700&display=swap","https://fonts.googleapis.com/css2?family=Noto+Serif+SC:wght@300;400;500;700&display=swap"]'
